# Copy to .env.local and fill in. .env.local is gitignored.

# Local Postgres 17 replica (db/build.sh). App connects as the unprivileged
# "authenticator" role and SET ROLEs per request so schema RLS applies.
DATABASE_URL="postgresql://authenticator@localhost:5433/snagdash"

# Signs the session cookie AND the attachment signed-URLs. Use a long random
# string (e.g. `openssl rand -base64 48`). Rotating it logs everyone out.
AUTH_SECRET=""

# Where the attachments bucket lives on disk.
STORAGE_DIR="./.storage"

# Local dev conveniences.
AUTH_AUTOCONFIRM="true"     # new sign-ups skip email confirmation
MAIL_PROVIDER="console"     # reset/confirm links go to the server log, not email

# Migration tooling only — NOT read by the app. Leave unset in normal use.
# SUPABASE_DIRECT_URL="postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:5432/postgres"
# SUPABASE_SERVICE_ROLE_KEY=""
